{
  "name": "dijkstra-tree",
  "version": "1.1.0",
  "description": "Implementation of Dijkstra's algorithm that returns a shortest path tree",
  "keywords": [
    "dijkstra",
    "shortest",
    "path",
    "tree"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "diagram": "node scripts/generate-diagram.ts",
    "prepublishOnly": "npm run build",
    "check:package": "node scripts/check-package.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linusnorton/dijkstra-tree.git"
  },
  "homepage": "https://github.com/linusnorton/dijkstra-tree#readme",
  "bugs": {
    "url": "https://github.com/linusnorton/dijkstra-tree/issues"
  },
  "author": "Linus Norton"
}
